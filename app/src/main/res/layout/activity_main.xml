<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/imageViewDashboard"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:contentDescription="@string/dashboard_image_description"
            android:src="@android:drawable/ic_menu_gallery" />

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/dashboard_title"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textTasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tasks_saved"
            android:textSize="18sp" />

        <Button
            android:id="@+id/buttonNovaTarefa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="24dp"
            android:text="@string/new_task" />

        <Button
            android:id="@+id/buttonVerTarefas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:text="@string/view_tasks" />

        <Button
            android:id="@+id/buttonSensorLuz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:text="@string/light_sensor" />

    </LinearLayout>
</ScrollView>